----------------------------------------------------------------------
-- Character / world helpers
----------------------------------------------------------------------
local function getHumanoid()
	local char = LocalPlayer.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function originPosition()
	local root = getRoot()
	if root then
		return root.Position
	end
	local cam = Workspace.CurrentCamera
	return cam and cam.CFrame.Position or nil
end

----------------------------------------------------------------------
-- Detection
----------------------------------------------------------------------
local FruitTokens = Util.buildTokens(Config.Fruit.KnownNames, Config.Fruit.LegacyAliases, Config.Fruit.ExtraNames)

local function inSearchRoot(inst)
	for _, root in ipairs(Config.Fruit.SearchRoots) do
		if inst:IsDescendantOf(root) then
			return true
		end
	end
	return false
end

-- true jika inst berada di dalam Model berisi Humanoid (pemain / NPC)
local function insideCharacter(inst)
	local p = inst.Parent
	while p and p ~= game do
		if p:IsA("Model") and p:FindFirstChildOfClass("Humanoid") then
			return true
		end
		p = p.Parent
	end
	return false
end

local function findHandle(inst, allowAnyPart)
	local h = inst:FindFirstChild(Config.Fruit.HandleName)
	if h and h:IsA("BasePart") then
		return h
	end
	if allowAnyPart then
		return inst:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

local function nameAccepted(inst)
	local name = inst.Name
	if Util.hasRejectPrefix(name, Config.Fruit.RejectPrefixes) then
		return false
	end
	local norm = Util.normalize(name)
	local hasKeyword = string.find(norm, Config.Fruit.NameKeyword, 1, true) ~= nil
	if inst:IsA("Tool") then
		return hasKeyword or Util.matchesAny(norm, FruitTokens)
	end
	return hasKeyword
end

-- returns "ok", handle | "wait" | "reject"
local function evaluate(inst)
	local isTool = inst:IsA("Tool")
	if not isTool and not inst:IsA("Model") then
		return "reject"
	end
	if not nameAccepted(inst) then
		return "reject"
	end
	if not isTool and inst:FindFirstChildOfClass("Humanoid") then
		return "reject"
	end
	if not inSearchRoot(inst) or insideCharacter(inst) then
		return "reject"
	end
	local handle = findHandle(inst, isTool)
	if not handle then
		return isTool and "wait" or "reject"
	end
	return "ok", handle
end

-- Nama generik ("Fruit ") -> coba ambil nama buah dari keturunannya.
-- ASSUMPTION (belum diverifikasi): nama buah bisa muncul sebagai nama child.
local function displayName(inst)
	local name = Util.trim(inst.Name)
	local norm = Util.normalize(name)
	if norm == " fruit " or norm == " fruits " then
		for _, d in ipairs(inst:GetDescendants()) do
			if Util.matchesAny(Util.normalize(d.Name), FruitTokens) then
				return Util.trim(d.Name) .. " (Fruit)"
			end
		end
	end
	if name == "" then
		return "Fruit"
	end
	return name
end

local function consider(inst, preexisting)
	if Tracked[inst] then
		return
	end
	if not (inst:IsA("Tool") or inst:IsA("Model")) then
		return
	end
	local ok, status, handle = pcall(evaluate, inst)
	if not ok then
		return
	end
	if status == "ok" then
		trackFruit(inst, preexisting, handle)
	elseif status == "wait" then
		Pending[inst] = Pending[inst] or (os.clock() + Config.Fruit.PendingSeconds)
	else
		Pending[inst] = nil
	end
end

-- Tool yang namanya belum cocok bisa diganti nama setelah di-parent: pantau sebentar.
local function watchTool(inst)
	if Watching[inst] then
		return
	end
	local c = inst:GetPropertyChangedSignal("Name"):Connect(function()
		consider(inst, false)
	end)
	Watching[inst] = c
	task.delay(Config.Fruit.WatchSeconds, function()
		if Watching[inst] == c then
			Watching[inst] = nil
		end
		c:Disconnect()
	end)
end

local function onDescendantAdded(inst)
	if not alive then
		return
	end
	local isTool = inst:IsA("Tool")
	if not (isTool or inst:IsA("Model")) then
		return
	end
	consider(inst, false)
	if isTool and not Tracked[inst] and not Pending[inst] then
		watchTool(inst)
	end
end


setStatus = function(msg)
	if msg then
		State.statusMsg = msg
	end
	if statusLabel and statusLabel.Parent then
		local count = 0
		for _ in pairs(Tracked) do
			count += 1
		end
		statusLabel.Text = string.format("%s | buah: %d | speed %d", State.statusMsg, count, State.speed)
	end
end

local function describe(rec)
	local age = os.clock() - rec.firstSeenClock
	local timeTxt
	if rec.preexisting then
		timeTxt = "sudah ada >= " .. Util.formatAge(age) .. " (spawn asli tak diketahui)"
	else
		timeTxt = "muncul " .. Util.formatAge(age) .. " lalu (" .. os.date("%H:%M:%S", rec.firstSeenWall) .. ")"
		if Config.DespawnSeconds then
			timeTxt = timeTxt .. " | sisa ~" .. Util.formatAge(math.max(0, Config.DespawnSeconds - age))
		end
	end
	return Util.formatDistance(rec.dist or 0, State.unit, Config.StudToMeter), timeTxt
end

