-- Cleanup + init
----------------------------------------------------------------------
local api = {}

Cleanup = function()
	if not alive then
		return
	end
	alive = false
	stopFlight("cleanup")
	for _, c in ipairs(connections) do
		c:Disconnect()
	end
	table.clear(connections)
	for inst, c in pairs(Watching) do
		c:Disconnect()
		Watching[inst] = nil
	end
	table.clear(Pending)
	for inst in pairs(Tracked) do
		untrack(inst)
	end
	for rec in pairs(rows) do
		removeRow(rec)
	end
	espFolder:Destroy()
	menuGui:Destroy()
	if env.__FruitFinder == api then
		env.__FruitFinder = nil
	end
end

api.Cleanup = Cleanup
env.__FruitFinder = api

local function scanLoop()
	local cfg = Config.Fruit
	local sinceDeep = cfg.DeepScanInterval -- pass pertama langsung deep scan
	while alive do
		for _, root in ipairs(cfg.SearchRoots) do
			for _, child in ipairs(root:GetChildren()) do
				consider(child, true)
			end
		end
		sinceDeep += cfg.FastScanInterval
		if sinceDeep >= cfg.DeepScanInterval then
			sinceDeep = 0
			for _, root in ipairs(cfg.SearchRoots) do
				local list = root:GetDescendants()
				for i = 1, #list do
					if i % cfg.ScanChunk == 0 then
						task.wait()
						if not alive then
							return
						end
					end
					consider(list[i], true)
				end
			end
		end
		task.wait(cfg.FastScanInterval)
	end
end

for _, root in ipairs(Config.Fruit.SearchRoots) do
	connect(root.DescendantAdded, onDescendantAdded)
end
task.spawn(scanLoop)
task.spawn(grabLoop)

