----------------------------------------------------------------------
-- Update loop
----------------------------------------------------------------------
local function sweep()
	for inst, rec in pairs(Tracked) do
		local keep = inSearchRoot(inst) and not insideCharacter(inst)
		if keep and not rec.handle:IsDescendantOf(inst) then
			local h = findHandle(inst, inst:IsA("Tool"))
			if h then
				rec.handle = h
				rec.esp.bb.Adornee = h
				rec.esp.hl.Adornee = h
			else
				keep = false
			end
		end
		if not keep then
			untrack(inst)
		end
	end
	local now = os.clock()
	for inst, expiry in pairs(Pending) do
		if now > expiry or not inSearchRoot(inst) then
			Pending[inst] = nil
		else
			consider(inst, false)
		end
	end
end

local function updateAll()
	local origin = originPosition()
	local count = 0
	for _, rec in pairs(Tracked) do
		local pos = rec.handle.Position
		local valid = origin ~= nil and Util.isPlausiblePosition(pos, Config.MaxCoord)
		rec.valid = valid
		rec.esp.bb.Enabled = State.espEnabled and valid
		rec.esp.hl.Enabled = State.espEnabled and valid
		if valid then
			count += 1
			rec.dist = (pos - origin).Magnitude
			local distTxt, timeTxt = describe(rec)
			rec.esp.nameLabel.Text = rec.name .. " | " .. distTxt
			rec.esp.infoLabel.Text = timeTxt
			if not rows[rec] then
				createRow(rec)
			end
			local row = rows[rec]
			row.frame.LayoutOrder = math.floor(rec.dist)
			row.label.Text = rec.name .. " | " .. distTxt .. "\n" .. timeTxt
		else
			removeRow(rec)
		end
	end
	emptyLabel.Visible = (count == 0)
end

