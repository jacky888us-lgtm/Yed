local function notifyFound(rec)
	if not State.notify or Seen[rec.inst] then
		return
	end
	Seen[rec.inst] = true
	local origin = originPosition()
	local distTxt = ""
	if origin then
		distTxt = " (" .. Util.formatDistance((rec.handle.Position - origin).Magnitude, State.unit, Config.StudToMeter) .. ")"
	end
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = "Fruit Finder",
			Text = rec.name .. distTxt,
			Duration = 5,
		})
	end)
end

trackFruit = function(inst, preexisting, handle)
	if not alive or Tracked[inst] then
		return
	end
	local rec = {
		inst = inst,
		handle = handle,
		name = displayName(inst),
		firstSeenClock = os.clock(),
		firstSeenWall = os.time(),
		preexisting = preexisting,
	}
	Tracked[inst] = rec
	Pending[inst] = nil
	buildEsp(rec)
	notifyFound(rec)
	setStatus()
end

untrack = function(inst)
	local rec = Tracked[inst]
	if not rec then
		return
	end
	Tracked[inst] = nil
	if rec.conn then
		rec.conn:Disconnect()
	end
	if rec.esp then
		rec.esp.bb:Destroy()
		rec.esp.hl:Destroy()
	end
	removeRow(rec)
	Blacklist[inst] = nil
	setStatus()
end

----------------------------------------------------------------------
-- Flight
----------------------------------------------------------------------
local Flight = { active = false }
local savedCollide = {}

local function setNoclip(char)
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			if savedCollide[part] == nil then
				savedCollide[part] = part.CanCollide
			end
			part.CanCollide = false
		end
	end
end

local function restoreCollide()
	for part, was in pairs(savedCollide) do
		if part.Parent then
			part.CanCollide = was
		end
		savedCollide[part] = nil
	end
end

stopFlight = function(reason)
	if not Flight.active then
		return
	end
	Flight.active = false
	if Flight.conn then
		Flight.conn:Disconnect()
		Flight.conn = nil
	end
	if Flight.stepConn then
		Flight.stepConn:Disconnect()
		Flight.stepConn = nil
	end
	restoreCollide()
	local root = getRoot()
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
	Flight.target = nil
	setStatus(reason or "berhenti")
end

local function noclipStep()
	local char = LocalPlayer.Character
	if char then
		setNoclip(char)
	end
end

local function flightStep(dt)
	local rec = Flight.target
	local root = getRoot()
	local hum = getHumanoid()
	if not root or not hum or hum.Health <= 0 then
		return stopFlight("karakter tidak tersedia")
	end
	if not rec or Tracked[rec.inst] ~= rec then
		if Flight.arrivedAt then
			return stopFlight("tiba, buah sudah hilang dari dunia (kemungkinan terambil)")
		end
		return stopFlight("buah hilang sebelum tiba")
	end
	local goal = rec.handle.Position + Config.Fly.ArriveOffset
	if not Util.isPlausiblePosition(goal, Config.MaxCoord) then
		return stopFlight("posisi target tidak valid")
	end
	if os.clock() > Flight.deadline then
		return stopFlight("timeout")
	end

	dt = math.min(dt, Config.Fly.MaxDt)
	local nextPos, arrived = Util.stepToward(root.Position, goal, State.speed, dt)
	root.CFrame = CFrame.new(nextPos) * root.CFrame.Rotation
	root.AssemblyLinearVelocity = Vector3.zero

	if arrived then
		Flight.arrivedAt = Flight.arrivedAt or os.clock()
		if os.clock() - Flight.arrivedAt >= Config.Fly.HoldSeconds then
			Blacklist[rec.inst] = os.clock() + Config.Fly.RetryAfter
			stopFlight("tiba, buah masih ada; auto-fly lewati " .. Config.Fly.RetryAfter .. "s")
		end
	end
end

startFlight = function(rec)
	if not alive then
		return
	end
	local root, hum = getRoot(), getHumanoid()
	if not root or not hum or hum.Health <= 0 then
		setStatus("karakter belum siap")
		return
	end
	if Tracked[rec.inst] ~= rec then
		setStatus("buah sudah tidak ada")
		return
	end
	if Flight.active then
		stopFlight("ganti target")
	end
	local dist = (rec.handle.Position - root.Position).Magnitude
	Flight.active = true
	Flight.target = rec
	Flight.arrivedAt = nil
	Flight.deadline = os.clock() + (dist / State.speed) * 2 + Config.Fly.TimeoutPadding
	Flight.stepConn = RunService.Stepped:Connect(noclipStep)
	Flight.conn = RunService.Heartbeat:Connect(flightStep)
	setStatus("terbang ke " .. rec.name)
end

local function nearestFruit(respectBlacklist)
	local origin = originPosition()
	if not origin then
		return nil
	end
	local now = os.clock()
	local best, bestDist
	for inst, rec in pairs(Tracked) do
		local pos = rec.handle.Position
		local blocked = respectBlacklist and Blacklist[inst] and Blacklist[inst] > now
		if not blocked and Util.isPlausiblePosition(pos, Config.MaxCoord) then
			local d = (pos - origin).Magnitude
			if not bestDist or d < bestDist then
				best, bestDist = rec, d
			end
		end
	end
	return best
end

----------------------------------------------------------------------
-- Grab (ambil jarak jauh)
----------------------------------------------------------------------
local GrabCooldown = setmetatable({}, { __mode = "k" }) -- [Instance] = os.clock() sampai kapan dilewati
local Grabbing = false
local Teleporting = false -- true selama satu teleport berjalan (pin + verifikasi + hold)

local function fruitTaken(inst)
	return not inSearchRoot(inst) or insideCharacter(inst)
end

local function waitTaken(inst, seconds)
	local deadline = os.clock() + seconds
	while os.clock() < deadline do
		if fruitTaken(inst) then
			return true
		end
		task.wait(0.05)
	end
	return fruitTaken(inst)
end

local function snapshotTools()
	local set = {}
	local function add(container)
		if container then
			for _, t in ipairs(container:GetChildren()) do
				if t:IsA("Tool") then
					set[t] = true
				end
			end
		end
	end
	add(LocalPlayer.Character)
	add(LocalPlayer:FindFirstChildOfClass("Backpack"))
	return set
end

local function findNewTool(before)
	local function scan(container)
		if container then
			for _, t in ipairs(container:GetChildren()) do
				if t:IsA("Tool") and not before[t] then
					return t
				end
			end
		end
		return nil
	end
	return scan(LocalPlayer.Character) or scan(LocalPlayer:FindFirstChildOfClass("Backpack"))
end

local function touchGrab(root, handle)
	local fn = (getgenv and getgenv().firetouchinterest) or firetouchinterest
	if type(fn) ~= "function" then
		return false
	end
	return (pcall(function()
		fn(root, handle, 0)
		task.wait()
		fn(root, handle, 1)
	end))
end

local function snapGrab(root, handle, inst)
	local home = root.CFrame
	root.CFrame = CFrame.new(handle.Position) * root.CFrame.Rotation
	root.AssemblyLinearVelocity = Vector3.zero
	local taken = waitTaken(inst, Config.Grab.SnapWait)
	if Config.Grab.ReturnHome and root.Parent then
		root.CFrame = home
		root.AssemblyLinearVelocity = Vector3.zero
	end
	return taken
end

local function grabOne(rec)
	local inst = rec.inst
	local root, hum = getRoot(), getHumanoid()
	if not root or not hum or hum.Health <= 0 then
		return
	end
	if not Util.isPlausiblePosition(rec.handle.Position, Config.MaxCoord) then
		GrabCooldown[inst] = os.clock() + Config.Grab.RetryAfter
		return
	end
	local before = snapshotTools()
	setStatus("ambil " .. rec.name)
	local taken, method = false, "touch"
	if touchGrab(root, rec.handle) then
		taken = waitTaken(inst, Config.Grab.TouchWait)
	end
	if not taken and Config.Grab.SnapFallback and Tracked[inst] == rec then
		method = "snap"
		taken = snapGrab(root, rec.handle, inst)
	end
	if not taken then
		GrabCooldown[inst] = os.clock() + Config.Grab.RetryAfter
		setStatus("gagal ambil " .. rec.name .. " (coba lagi " .. Config.Grab.RetryAfter .. "s)")
		return
	end
	if Config.Grab.Equip then
		local tool
		local deadline = os.clock() + Config.Grab.EquipWait
		repeat
			tool = findNewTool(before)
			if not tool then
				task.wait(0.05)
			end
		until tool or os.clock() > deadline
		if tool and tool.Parent ~= LocalPlayer.Character then
			pcall(function()
				hum:EquipTool(tool)
			end)
		end
		setStatus(string.format("terambil (%s): %s%s", method, rec.name, tool and "" or " | tool tidak ditemukan di tas"))
	else
		setStatus(string.format("terambil (%s): %s", method, rec.name))
	end
end

local function grabLoop()
	while alive do
		task.wait(Config.Grab.Interval)
		if State.autoGrab and not Grabbing and not Teleporting and not Flight.active then
			local origin = originPosition()
			local now = os.clock()
			local target, bestDist
			if origin then
				for inst, rec in pairs(Tracked) do
					if not (GrabCooldown[inst] and GrabCooldown[inst] > now) then
						local pos = rec.handle.Position
						if Util.isPlausiblePosition(pos, Config.MaxCoord) then
							local d = (pos - origin).Magnitude
							if not bestDist or d < bestDist then
								target, bestDist = rec, d
							end
						end
					end
				end
			end
			if target then
				Grabbing = true
				local ok, err = pcall(grabOne, target)
				Grabbing = false
				if not ok then
					GrabCooldown[target.inst] = os.clock() + Config.Grab.RetryAfter
					warn("[FruitFinder] grab error:", err)
				end
			end
		end
	end
end

local function grabManual(rec)
	if not alive or Grabbing or Teleporting then
		setStatus("grab/teleport sedang berjalan")
		return
	end
	if Tracked[rec.inst] ~= rec then
		setStatus("buah sudah tidak ada")
		return
	end
	task.spawn(function()
		Grabbing = true
		local ok, err = pcall(grabOne, rec)
		Grabbing = false
		if not ok then
			GrabCooldown[rec.inst] = os.clock() + Config.Grab.RetryAfter
			warn("[FruitFinder] grab error:", err)
		end
	end)
end

----------------------------------------------------------------------
-- Teleport (instan, tanpa terbang)
----------------------------------------------------------------------
local TeleportCooldown = setmetatable({}, { __mode = "k" }) -- [Instance] = os.clock() sampai kapan dilewati
local lastAutoTeleport = 0

local function equipNewTool(before)
	local tool
	local deadline = os.clock() + Config.Grab.EquipWait
	repeat
		tool = findNewTool(before)
		if not tool then
			task.wait(0.05)
		end
	until tool or os.clock() > deadline or not alive
	local hum = getHumanoid()
	if tool and hum and tool.Parent ~= LocalPlayer.Character then
		pcall(function()
			hum:EquipTool(tool)
		end)
	end
	return tool
end

-- Satu lompatan CFrame ke posisi Handle, pin beberapa frame, lalu verifikasi hasilnya.
local function teleportRun(rec)
	local cfg = Config.Teleport
	local inst = rec.inst
	local root, hum = getRoot(), getHumanoid()
	if not root or not hum or hum.Health <= 0 then
		setStatus("karakter belum siap")
		return
	end

	local function currentGoal()
		if Tracked[inst] == rec and rec.handle.Parent then
			local p = rec.handle.Position + cfg.Offset
			if Util.isPlausiblePosition(p, Config.MaxCoord) then
				return p
			end
		end
		return nil
	end

	local goal = currentGoal()
	if not goal then
		TeleportCooldown[inst] = os.clock() + cfg.RetryAfter
		setStatus("posisi target tidak valid atau buah sudah hilang")
		return
	end

	if Flight.active then
		stopFlight("ganti ke teleport")
	end
	local before = snapshotTools()
	setStatus("teleport ke " .. rec.name)

	local pinUntil = os.clock() + cfg.PinSeconds
	repeat
		local r = getRoot()
		if not r then
			setStatus("karakter hilang saat teleport")
			return
		end
		goal = currentGoal() or goal
		r.CFrame = CFrame.new(goal) * r.CFrame.Rotation
		r.AssemblyLinearVelocity = Vector3.zero
		r.AssemblyAngularVelocity = Vector3.zero
		RunService.Heartbeat:Wait()
	until os.clock() >= pinUntil or not alive
	if not alive then
		return
	end

	root = getRoot()
	if not root then
		setStatus("karakter hilang saat teleport")
		return
	end
	if cfg.TouchAfter then
		touchGrab(root, rec.handle)
	end

	if waitTaken(inst, cfg.HoldSeconds) then
		local tool
		if Config.Grab.Equip then
			tool = equipNewTool(before)
		else
			tool = findNewTool(before)
		end
		if tool then
			setStatus("terambil (teleport): " .. rec.name)
		else
			setStatus("buah " .. rec.name .. " hilang dari dunia, tapi tool baru tidak ditemukan (bisa diambil pemain lain)")
		end
		return
	end

	task.wait(cfg.VerifyWait)
	root = getRoot()
	if not root then
		return
	end
	TeleportCooldown[inst] = os.clock() + cfg.RetryAfter
	local off = (root.Position - goal).Magnitude
	if off > cfg.VerifyRadius then
		setStatus(string.format("teleport ke %s kemungkinan ditolak/ditarik balik server (%d studs dari buah)", rec.name, math.floor(off + 0.5)))
	else
		setStatus(string.format("tiba di %s tapi buah masih ada; Auto-TP lewati %ds", rec.name, cfg.RetryAfter))
	end
end

teleportToFruit = function(rec)
	if not alive then
		return
	end
	if Teleporting or Grabbing then
		setStatus("grab/teleport sedang berjalan")
		return
	end
	if Tracked[rec.inst] ~= rec then
		setStatus("buah sudah tidak ada")
		return
	end
	Teleporting = true
	task.spawn(function()
		local ok, err = pcall(teleportRun, rec)
		Teleporting = false
		if not ok then
			TeleportCooldown[rec.inst] = os.clock() + Config.Teleport.RetryAfter
			warn("[FruitFinder] teleport error:", err)
			setStatus("teleport error (lihat console)")
		end
	end)
end

local function nearestTeleportTarget()
	local origin = originPosition()
	if not origin then
		return nil
	end
	local now = os.clock()
	local best, bestDist
	for inst, rec in pairs(Tracked) do
		local pos = rec.handle.Position
		local blocked = TeleportCooldown[inst] and TeleportCooldown[inst] > now
		if not blocked and Util.isPlausiblePosition(pos, Config.MaxCoord) then
			local d = (pos - origin).Magnitude
			if not bestDist or d < bestDist then
				best, bestDist = rec, d
			end
		end
	end
	return best
end

autoTeleportTick = function()
	if not State.autoTeleport or Teleporting or Grabbing or Flight.active then
		return
	end
	local now = os.clock()
	if now - lastAutoTeleport < Config.Teleport.AutoInterval then
		return
	end
	local rec = nearestTeleportTarget()
	if rec then
		lastAutoTeleport = now
		teleportToFruit(rec)
	end
end

